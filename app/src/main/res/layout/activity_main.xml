<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- MAP VIEW — Full screen background                         -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <org.osmdroid.views.MapView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- TOP STATUS PILL — Glassmorphic, wide                      -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardStatus"
        android:layout_width="0dp"
        android:layout_height="@dimen/status_bar_height"
        android:layout_marginTop="44dp"
        android:layout_marginHorizontal="20dp"
        app:cardBackgroundColor="@color/surface_elevated"
        app:cardCornerRadius="@dimen/corner_radius_large"
        app:cardElevation="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border_purple"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:gravity="center_vertical">

            <!-- Status Dot -->
            <View
                android:id="@+id/statusDot"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:background="@drawable/status_dot_bg"
                android:backgroundTint="@color/secondary_mesh_green"/>

            <!-- Status Text -->
            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="ONLINE • 0 peers"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="@dimen/text_body"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.05"/>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="@color/divider"
                android:layout_marginHorizontal="12dp"/>

            <!-- Settings Button -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary"
                android:contentDescription="Settings"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- DANGER ZONE FAB                                           -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnDanger"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/ic_warning"
        app:backgroundTint="@color/primary_sos_red"
        app:tint="@color/text_primary"
        app:elevation="10dp"
        app:fabSize="normal"
        app:layout_constraintBottom_toTopOf="@+id/bottomDock"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="Danger Zone"/>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- SILENCE ALARM (hidden by default)                         -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStopAlarm"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="SILENCE ALARM"
        android:textColor="@color/background"
        android:textStyle="bold"
        android:textSize="@dimen/text_body"
        android:visibility="gone"
        app:icon="@drawable/ic_volume_off"
        app:iconTint="@color/background"
        app:backgroundTint="@color/warning_orange"
        app:cornerRadius="@dimen/corner_radius_pill"
        app:layout_constraintBottom_toTopOf="@+id/btnDanger"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="12dp"/>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- BOTTOM DOCK — Glassmorphic navigation bar                 -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomDock"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_bar_height"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="@dimen/corner_radius_large"
        app:cardElevation="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="3">

            <!-- Chat Button -->
            <LinearLayout
                android:id="@+id/btnToggleChat"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:layout_width="@dimen/icon_size_nav"
                    android:layout_height="@dimen/icon_size_nav"
                    android:src="@drawable/ic_chat"
                    app:tint="@color/text_primary"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chat"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Spacer for SOS button -->
            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>

            <!-- Talk / Mic Button -->
            <LinearLayout
                android:id="@+id/btnMic"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">
                <ImageView
                    android:id="@+id/icMic"
                    android:layout_width="@dimen/icon_size_nav"
                    android:layout_height="@dimen/icon_size_nav"
                    android:src="@drawable/ic_mic"
                    app:tint="@color/text_primary"/>
                <TextView
                    android:id="@+id/tvMic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Talk"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_caption"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- SOS BUTTON — Premium glowing orb                          -->
    <!-- ══════════════════════════════════════════════════════════ -->

    <!-- Glow Ring (behind the button) -->
    <View
        android:id="@+id/sosGlow"
        android:layout_width="@dimen/sos_glow_size"
        android:layout_height="@dimen/sos_glow_size"
        android:background="@drawable/bg_sos_ring"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- SOS Inner Button -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSos"
        android:layout_width="@dimen/sos_button_size"
        android:layout_height="@dimen/sos_button_size"
        app:cardCornerRadius="@dimen/corner_radius_pill"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardElevation="20dp"
        app:strokeWidth="0dp"
        android:layout_marginBottom="34dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/sosContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_sos_fill">

            <!-- Progress indicator for long-press -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/sosProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                app:indicatorSize="@dimen/sos_button_size"
                app:indicatorColor="@color/primary_purple_light"
                app:trackColor="@android:color/transparent"
                app:trackThickness="6dp"
                android:max="100"
                android:progress="0"
                app:indicatorDirectionCircular="clockwise"
                android:visibility="invisible"/>

            <!-- SOS Label -->
            <TextView
                android:id="@+id/tvSosText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="SOS"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:textSize="@dimen/text_sos"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.1"/>
        </FrameLayout>

        <!-- Click target overlay -->
        <View
            android:id="@+id/btnSos"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"/>
    </com.google.android.material.card.MaterialCardView>

    <!-- ══════════════════════════════════════════════════════════ -->
    <!-- CHAT OVERLAY — Glassmorphic card                          -->
    <!-- ══════════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/layoutChat"
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_margin="20dp"
        app:cardCornerRadius="@dimen/corner_radius_large"
        app:cardBackgroundColor="@color/surface_elevated"
        app:cardElevation="24dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border_purple"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/bottomDock">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Chat Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="20dp"
                    android:background="@color/primary_purple"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="SECURE CHAT"
                    android:textColor="@color/primary_purple_light"
                    android:textStyle="bold"
                    android:textSize="@dimen/text_body"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.1"/>

                <ImageButton
                    android:id="@+id/btnChatClose"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:padding="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_secondary"/>
            </LinearLayout>

            <!-- Chat Messages -->
            <ScrollView
                android:id="@+id/chatScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fadingEdge="vertical"
                android:fadingEdgeLength="16dp"
                android:requiresFadingEdge="vertical">
                <TextView
                    android:id="@+id/tvChatLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="> Channel Open...\n"
                    android:textColor="@color/text_primary"
                    android:fontFamily="monospace"
                    android:textSize="@dimen/text_caption"
                    android:lineSpacingExtra="4dp"
                    android:paddingBottom="8dp"/>
            </ScrollView>

            <!-- Chat Input Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/etMessage"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:hint="Type message..."
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_tertiary"
                    android:background="@drawable/chat_input_bg"
                    android:paddingHorizontal="16dp"
                    android:textSize="@dimen/text_body"/>

                <ImageButton
                    android:id="@+id/btnPlayAudio"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:padding="10dp"
                    android:background="@drawable/circle_btn_bg"
                    android:src="@drawable/ic_play"
                    android:visibility="gone"
                    app:tint="@color/text_primary"/>

                <ImageButton
                    android:id="@+id/btnSend"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="8dp"
                    android:padding="10dp"
                    android:background="@drawable/circle_btn_bg"
                    android:src="@drawable/ic_send"
                    app:tint="@color/text_primary"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>